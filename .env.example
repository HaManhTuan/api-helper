# Server settings
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
DEBUG=True
APP_PORT=8000

# Project settings
PROJECT_NAME="API Helper Application"
PROJECT_DESCRIPTION="API Helper Application"
PROJECT_VERSION="0.1.0"

# Database settings
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/helpers_api
DATABASE_URL_DOCKER=postgresql://postgres:postgres@db:5432/helpers_api
DB_ECHO=False
AUTO_CREATE_TABLES=False
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=helpers_api
POSTGRES_PORT=5432
POSTGRES_PORT_HOST=5433

# Logging
LOG_LEVEL=INFO
LOG_FILE_PATH=logs/app.log

# Redis and Celery
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PORT_HOST=6379
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_BROKER_URL_DOCKER=redis://redis:6379/0
CELERY_RESULT_BACKEND_DOCKER=redis://redis:6379/0

# JWT Auth
JWT_SECRET_KEY=change_this_to_a_secure_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080
