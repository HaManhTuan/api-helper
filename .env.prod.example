# Server settings
APP_ENV=production
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
APP_PORT=8000
DEBUG=False
UVICORN_WORKERS=2

# Project settings
PROJECT_NAME="API Helper Application"
PROJECT_DESCRIPTION="API Helper Application"
PROJECT_VERSION="0.1.0"

# Database settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=helpers_api
POSTGRES_PORT=5432
DATABASE_URL_DOCKER=postgresql://postgres:CHANGE_ME_STRONG_PASSWORD@db:5432/helpers_api
DB_ECHO=False
AUTO_CREATE_TABLES=False

# Redis and Celery
REDIS_PORT=6379
REDIS_DB=0
CELERY_CONCURRENCY=50
CELERY_BROKER_URL_DOCKER=redis://redis:6379/0
CELERY_RESULT_BACKEND_DOCKER=redis://redis:6379/0

# Logging
LOG_LEVEL=INFO
LOG_FILE_PATH=logs/app.log

# JWT Auth
JWT_SECRET_KEY=CHANGE_ME_TO_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080
